# Application Environment
ENV=dev
HTTP_PORT=50051

# Downstream gRPC services
GRPC_SERVICES__PRODUCT__HOST=localhost
GRPC_SERVICES__PRODUCT__PORT=50060

# HTTP server limits and timeouts
# REQUEST_TIMEOUT is the deadline propagated to the downstream gRPC call:
# keep it slightly above the downstream timeout and below WRITE_TIMEOUT.
SERVER__READ_HEADER_TIMEOUT=5s
SERVER__READ_TIMEOUT=15s
SERVER__WRITE_TIMEOUT=30s
SERVER__IDLE_TIMEOUT=60s
SERVER__REQUEST_TIMEOUT=10s
SERVER__SHUTDOWN_DRAIN_DELAY=5s
SERVER__SHUTDOWN_TIMEOUT=10s
SERVER__MAX_REQUEST_BODY_BYTES=1048576
SERVER__MAX_HEADER_BYTES=8192

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://172.93.163.153
